/results/
/staging/
/examples/
/projects/
/package_status.json
/tests/runtime/
/bin/WinPython/
/bin/*.exe
/tools/fastdvdnet/
/reports/

# Python caches, environments, build and test output
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
