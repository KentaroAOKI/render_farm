.vs/
.DS_Store
Thumbs.db
Desktop.ini

# Public repository allowlist. New top-level files and generated files under
# source directories must be reviewed before they can be added.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/asset_paths.example.json
!/farm_cli.py
!/launch.ps1
!/start.cmd
